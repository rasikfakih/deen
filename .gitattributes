# Enforce LF for all text files, CRLF only for Windows batch/PowerShell
* text=auto eol=lf

# Windows scripts must stay CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Explicit text types (ensure LF even if autodetect fails)
*.dart text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.sha256 text eol=lf
*.plist text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.kts text eol=lf
*.properties text eol=lf
*.txt text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.ts text eol=lf

# Binary -- do not touch line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.mp3 binary
*.m4a binary
*.ogg binary
*.zip binary
*.gz binary
*.pdf binary