<?xml version="1.0" encoding="utf-8"?>
<!-- Branded splash: cream background (#F9F6F0) + centered launcher icon.
     Matches flutter_native_splash color + AppColors.cream. Regenerate via
     `dart run flutter_native_splash:create` after changing assets/icon.png. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="#F9F6F0" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
