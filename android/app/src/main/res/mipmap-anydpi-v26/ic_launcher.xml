<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon (API 26+): cream background + launcher foreground.
     Regenerate with `dart run flutter_launcher_icons` after updating assets/icon.png. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="#F9F6F0" />
    <foreground android:drawable="@mipmap/ic_launcher" />
    <monochrome android:drawable="@mipmap/ic_launcher" />
</adaptive-icon>
